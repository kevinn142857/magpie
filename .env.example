# Required: the address recipients use for package links and API requests.
# For a public deployment, set your HTTPS domain, e.g. https://api.example.com.
MAGPIE_PUBLIC_URL=http://127.0.0.1:3430

# Required: generate a unique administrator key with `openssl rand -hex 32`.
# Leave no spaces around '=', and keep this key separate from package keys.
# An empty value deliberately prevents Docker Compose from starting.
MAGPIE_WEB_KEY=

# Optional: bind only to this computer by default.
# Set 0.0.0.0 explicitly to accept connections through the host's interfaces.
MAGPIE_HOST=127.0.0.1
MAGPIE_PORT=3430

# Optional: version shown by the locally built binary.
MAGPIE_VERSION=packages-dev
